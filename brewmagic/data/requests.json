  {"id": "valour_retired_wizard_1", "potion": "valour_cordial", "archetype": "retired_wizard", "hints": ["hint_courage", "hint_calm", "hint_spooky"], "text": "A dragon owes me money. I need courage, calm and a spooky stare."},
  {"id": "valour_retired_wizard_2", "potion": "valour_cordial", "archetype": "retired_wizard", "hints": ["hint_night", "hint_brave", "hint_cool"], "text": "Must face my old rival at night. Brave but cool, like in '52."},
  {"id": "valour_retired_wizard_3", "potion": "valour_cordial", "archetype": "retired_wizard", "hints": ["hint_curse", "hint_courage", "hint_calm"], "text": "The cursed library has my spectacles. Courage! And calm!"},

  {"id": "moonbloom_retired_wizard_1", "potion": "moonbloom_draught", "archetype": "retired_wizard", "hints": ["hint_grow", "hint_cool", "hint_night"], "text": "My moonflowers won't grow. Need a cool, nightly charm. Old trick."},
  {"id": "moonbloom_retired_wizard_2", "potion": "moonbloom_draught", "archetype": "retired_wizard", "hints": ["hint_heal", "hint_curse", "hint_calm"], "text": "Heal my cursed beard, apprentice. It hums at people. Calmly."},
  {"id": "moonbloom_retired_wizard_3", "potion": "moonbloom_draught", "archetype": "retired_wizard", "hints": ["hint_fresh", "hint_cold", "hint_spooky"], "text": "A fresh, cold, spooky tonic. For my garden. Or my cat. One of them."},

  {"id": "hearthglow_busy_baker_1", "potion": "hearthglow_tonic", "archetype": "busy_baker", "hints": ["hint_heal", "hint_brave"], "text": "Quick! Burnt my thumb! Something to heal it and keep me brave!"},
