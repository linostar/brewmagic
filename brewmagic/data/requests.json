  {"id": "valour_night_watchman_2", "potion": "valour_cordial", "archetype": "night_watchman", "hints": ["hint_spooky", "hint_brave", "hint_cool"], "text": "Spooky alley. Brave face needed. Cool head. Official request."},
  {"id": "valour_night_watchman_3", "potion": "valour_cordial", "archetype": "night_watchman", "hints": ["hint_night", "hint_courage", "hint_cold"], "text": "Night shift by the crypt. Courage and a cold stare, please."},

