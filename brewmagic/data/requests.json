  {"id": "valour_busy_baker_1", "potion": "valour_cordial", "archetype": "busy_baker", "hints": ["hint_spooky", "hint_courage", "hint_calm"], "text": "Delivering pies to the spooky castle! Need courage and calm! Hurry!"},
