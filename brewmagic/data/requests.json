  { "id": "moonbloom_apprentice_knight_2", "potion": "moonbloom_draught", "archetype": "apprentice_knight", "hints": ["hint_grow", "hint_night", "hint_cold"], "text": "The castle herbs won't grow. It's always night and cold up there. Help?" },
  { "id": "moonbloom_apprentice_knight_3", "potion": "moonbloom_draught", "archetype": "apprentice_knight", "hints": ["hint_spooky", "hint_grow", "hint_calm"], "text": "Sorry, the spooky hedge maze won't grow. Can it be calm about it?" },

  { "id": "moonbloom_gossip_granny_1", "potion": "moonbloom_draught", "archetype": "gossip_granny", "hints": ["hint_curse", "hint_night", "hint_heal", "hint_cool"], "text": "My cursed petunias gossip all night. Heal them, cool them down, dear." },
  { "id": "moonbloom_gossip_granny_2", "potion": "moonbloom_draught", "archetype": "gossip_granny", "hints": ["hint_grow", "hint_spooky", "hint_cold"], "text": "Help my roses grow for the vicar's ghost. Spooky, cold, lovely." },
  { "id": "moonbloom_gossip_granny_3", "potion": "moonbloom_draught", "archetype": "gossip_granny", "hints": ["hint_night", "hint_grow", "hint_calm"], "text": "My night garden needs to grow, dearie. Quietly. Calmly. Edna's watching." },

  {"id": "hearthglow_retired_wizard_1", "potion": "hearthglow_tonic", "archetype": "retired_wizard", "hints": ["hint_warm", "hint_heal"], "text": "My old bones need something warm and healing. Where was I?"},
  {"id": "hearthglow_retired_wizard_2", "potion": "hearthglow_tonic", "archetype": "retired_wizard", "hints": ["hint_fire", "hint_fresh"], "text": "I left my fire spell in 1402. Something fresh to fill the gap?"},
