  {"id": "valour_retired_wizard_1", "potion": "valour_cordial", "archetype": "retired_wizard", "hints": ["hint_courage", "hint_calm", "hint_spooky"], "text": "A dragon owes me money. I need courage, calm and a spooky stare."},
