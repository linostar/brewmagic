  {"id": "hearthglow_night_watchman_1", "potion": "hearthglow_tonic", "archetype": "night_watchman", "hints": ["hint_warm", "hint_heal"], "text": "Patrol report: numb toes. Requesting something warm and healing."},
  {"id": "hearthglow_night_watchman_2", "potion": "hearthglow_tonic", "archetype": "night_watchman", "hints": ["hint_courage", "hint_fresh"], "text": "Officer needs courage and a fresh pair of legs. Official request."},
