  {"id": "slumber_busy_baker_1", "potion": "slumber_syrup", "archetype": "busy_baker", "hints": ["hint_sleep", "hint_calm"], "text": "Up at four every day! I need sleep! And calm! And a nap! Go go!"},
  {"id": "slumber_busy_baker_2", "potion": "slumber_syrup", "archetype": "busy_baker", "hints": ["hint_night", "hint_spooky", "hint_calm"], "text": "The bakery's haunted at night! Spooky crumbs! Calm me, quick!"},
