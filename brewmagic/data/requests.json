  {"id": "moonbloom_busy_baker_1", "potion": "moonbloom_draught", "archetype": "busy_baker", "hints": ["hint_grow", "hint_night", "hint_cold"], "text": "My herb pots won't grow at night! It's too cold! Help, quickly!"},
  {"id": "moonbloom_busy_baker_2", "potion": "moonbloom_draught", "archetype": "busy_baker", "hints": ["hint_curse", "hint_heal", "hint_calm"], "text": "My sourdough starter is cursed! Heal it! Calm it! Fast!"},
  {"id": "moonbloom_busy_baker_3", "potion": "moonbloom_draught", "archetype": "busy_baker", "hints": ["hint_fresh", "hint_spooky", "hint_cool"], "text": "Need fresh mint for spooky biscuits! Cool ones! Ten minutes!"},

  {"id": "hearthglow_haughty_noble_1", "potion": "hearthglow_tonic", "archetype": "haughty_noble", "hints": ["hint_grow", "hint_warm"], "text": "One's hothouse orchids refuse to grow. Something warm, please."},
  {"id": "hearthglow_haughty_noble_2", "potion": "hearthglow_tonic", "archetype": "haughty_noble", "hints": ["hint_courage", "hint_heal"], "text": "One needs courage for my aunt's ball, and to heal afterwards."},
