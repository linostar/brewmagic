[ext_resource type="Script" path="res://scripts/stations/stir.gd" id="1_stir"]

[sub_resource type="Shader" id="Shader_ghost"]
code = "shader_type canvas_item;
// The ghost ladle: the ladle's pixels washed towards a pale blue, keeping the
// sprite's alpha times the node's modulate alpha (the demo fades through it).
uniform vec3 tint : source_color = vec3(0.78, 0.91, 0.97);
uniform float wash = 0.75;

void fragment() {
	COLOR.rgb = mix(COLOR.rgb, tint, wash);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_ghost"]
shader = SubResource("Shader_ghost")

